# Gitee MCP configuration - copy to .env and fill in what you need.
# Anonymous mode works out of the box (rate-limited to ~60 requests/hour).

# Gitee personal access token (optional but recommended).
# Anonymous tier: repo details, readme, languages, commits, branches, user search.
# Token tier adds: repo search, star/forks sorted discovery, stargazer lists.
# Create at: https://gitee.com/profile/personal_access_tokens/new  (free, no CC)
GITEE_TOKEN=

# Gitee API base (defaults to the public v5 API)
GITEE_API_BASE=https://gitee.com/api/v5

# Webhook receiver secret - POST /api/webhooks/gitee checks the X-Gitee-Token header.
# Set the same value in your Gitee repo webhook config.
GITEE_WEBHOOK_SECRET=

# Local LLM for zh->en translation of repo descriptions (Ollama, OpenAI-compatible).
# Leave empty to use http://127.0.0.1:11434/v1 with model below.
GITEE_LLM_BASE_URL=
GITEE_LLM_MODEL=qwen2.5:7b

# Cache TTL in seconds for repo metadata (default 600 = 10 min, saves anonymous quota)
GITEE_CACHE_TTL=600

# Comma-separated seed repos for the "humming now" radar (owner/repo).
# Defaults to a curated list of genuinely popular Gitee projects.
GITEE_SEED_REPOS=

# Webapp ports (fleet registry: 11161 backend / 11162 frontend)
GITEE_BACKEND_PORT=11161
GITEE_FRONTEND_PORT=11162
